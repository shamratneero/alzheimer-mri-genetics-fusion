venv/
train/
test/
*.jpg
*.jpeg
*.png
.ipynb_checkpoints/
__pycache__/
*.pyc
preprocessed/
*.nii.gz

# Ignore everything under outputs/ by default, then re-include the small
# result files. Note: git will not descend into an excluded *directory*, so
# the directories are re-included first, then their contents filtered.
outputs/*
!outputs/cv/
!outputs/logs/
!outputs/adni_external/

outputs/checkpoints*/
# model checkpoints are ~42MB each and are not tracked
*.pt
*.pth
adni_pilot/
adni_nifti/
preprocessed_adni/
# CV fold checkpoints - ~840MB, regenerable, not tracked
outputs/cv_checkpoints/
!figures_gradcam*/*.png
!outputs/temperature/
!outputs/sample_size/
!outputs/sample_size/*.png
!outputs/resnet2d/
!outputs/resnet2d_scratch/